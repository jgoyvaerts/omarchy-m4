# m4-support: boot entries (m4-boot), mkinitcpio hooks, systemd units, modprobe.d, session and device helpers for the Apple M4 (T6040, J616s).
# Built from the repo tree userspace/support; machine values come from local.conf (tools/template.py). Build: makepkg -f (on the M4).
pkgname=m4-support
pkgver=1.0
pkgrel=38
pkgdesc='M4 (Apple T6040 / J616s) platform support: m4-boot, mkinitcpio hooks, units, modprobe.d, session and device helpers'
arch=(any)
url='https://github.com/jgoyvaerts/omarchy-m4'
license=(GPL-2.0-only)
depends=(python mkinitcpio kmod systemd util-linux e2fsprogs coreutils sddm uwsm hyprland bluez bluez-utils wireplumber libnotify
         qt6-declarative 'linux-m4>=7.1.12-11' m4-firmware m4-aurora-mesa
         asahi-audio speakersafetyd alsa-ucm-conf-asahi)
backup=(etc/m4/mkinitcpio.conf etc/m4/bluetooth.conf etc/sddm.conf.d/zz-m4.conf etc/xdg/uwsm/env-hyprland etc/pacman.d/hooks/90-mkinitcpio-install.hook)

package() {
  local top="$startdir/../.."
  # M4_LOCAL_CONF=/dev/null builds the machine-neutral package (the public repository)
  local conf="${M4_LOCAL_CONF:-$top/local.conf}"
  [ -e "$conf" ] || { echo "local.conf is missing: run tools/make-local-conf.sh, or set M4_LOCAL_CONF=/dev/null" >&2; return 1; }
  cp -a "$top/userspace/support/usr" "$top/userspace/support/etc" "$pkgdir/"
  python3 "$top/tools/template.py" --conf "$conf" --in-place "$pkgdir"
  chmod 755 "$pkgdir"/usr/bin/{m4-boot,m4-speakers} "$pkgdir"/usr/lib/m4/{modules-cleanup,sddm-compositor,session-start,shell-policy,safe-notice,gpu-load,display-load,bt-connect,bt-keyshare.py,kbd-idle.py,als-brightness.py,gpu-idle-power}
  chmod 755 "$pkgdir"/usr/lib/systemd/system-shutdown/m4-ssd-sync
  find "$pkgdir" -name __pycache__ -prune -exec rm -rf {} +
}
